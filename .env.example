# Copy this to .env and fill in real values before running

# Postgres (matches docker-compose.yml — no changes needed for local dev)
DATABASE_URL="postgresql://portal:portal_dev_password@localhost:5432/portal_dev?schema=public"

# Redis (matches docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-string-run-openssl-rand-base64-32"

# Single admin login (solo-operator model — Section 6 of the blueprint)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-local-password"

# OpenAI — only used for drafting titles/summaries, never legal text (Section 6.2)
OPENAI_API_KEY=""

# Public site canonical base URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
