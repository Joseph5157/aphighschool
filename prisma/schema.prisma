generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  notification
  apply_link
  hall_ticket
  results
  expired
}

enum RelatedOrderSource {
  ai_suggested
  manual
}

enum DocType {
  go
  circular
  memo
  proceeding
  notification
  other
}

/// Lifecycle for an ordinary order/circular/memo. Recruitment notifications
/// use PostStatus instead — see lib/posts/lifecycle.ts.
enum OrderState {
  current
  amended
  superseded
  archived
}

model Category {
  id        String   @id @default(uuid())
  nameEn    String
  nameTe    String
  slug      String   @unique
  color     String?
  icon      String?
  posts     Post[]
  createdAt DateTime @default(now())
}

model Post {
  id                 String     @id @default(uuid())
  slug               String     @unique
  titleEn            String
  titleTe            String
  summaryTe          String[]   // Telugu bullet points
  englishAbstract    String?
  tags               String[]   @default([])
  /// The document type as a closed set. Backfilled from the legacy free-text
  /// docType column, which was dropped in Task 14.
  documentType        DocType?
  /// Lifecycle state for non-recruitment documents.
  orderState          OrderState @default(current)
  /// The date the order was actually issued by the department. NULL when no
  /// verifiable date exists — never inferred. Distinct from createdAt, which is
  /// the CMS ingestion timestamp.
  documentDate        DateTime?
  /// Sort/index helper ONLY — never read for display. Always equals
  /// COALESCE(documentDate, createdAt). Prisma's `orderBy` cannot express
  /// COALESCE directly, so app/actions/posts.ts (createPost/updatePost) keeps
  /// this column in sync on every write that touches documentDate. Rows
  /// created without a documentDate never need explicit syncing: Postgres
  /// evaluates `now()` once per transaction, so this column's @default(now())
  /// and createdAt's @default(now()) resolve to the identical timestamp on
  /// insert. Display code must keep using officialDate()/dateLabel() from
  /// lib/dates.ts, which compute fresh from documentDate/createdAt — never
  /// from this column — so a sync bug here can never surface a false date.
  effectiveDate      DateTime   @default(now())
  statusBadge        PostStatus @default(notification)
  pdfUrl             String?    // Google Drive link, Day 1 (Section 6.1)
  actionUrl          String?
  actionDeadline     DateTime?
  category           Category?  @relation(fields: [categoryId], references: [id])
  categoryId         String?
  goReference        String?    // e.g. G.O.Ms.No.129
  sourceDept         String?
  sourceUrl          String?
  content            String?    // Full structured content / tables / guides
  verifiedAgainstGoir Boolean   @default(false)
  isDraft             Boolean   @default(true)

  // Related Orders — this post links TO these background/prior orders
  relatedFrom RelatedOrder[] @relation("PostRelatedFrom")
  // Related Orders — other posts that link back to THIS post as background
  relatedTo   RelatedOrder[] @relation("PostRelatedTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([effectiveDate])
}

model RelatedOrder {
  post             Post                @relation("PostRelatedFrom", fields: [postId], references: [id], onDelete: Cascade)
  postId           String
  relatedPost      Post                @relation("PostRelatedTo", fields: [relatedPostId], references: [id], onDelete: Cascade)
  relatedPostId    String
  relationshipNote String?             // e.g. "Original PTR norms", "Superseded by this order"
  source           RelatedOrderSource  @default(ai_suggested)
  approved         Boolean             @default(false)

  @@id([postId, relatedPostId])
}
